# Copie para .env e preencha. Nunca commite o .env.

# GitHub — usuário cujos repositórios aparecem no portfólio
VITE_GITHUB_USERNAME=gjrzz

# Supabase — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — envio do formulário de contato para o dono do site
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Apenas para o MCP do Supabase no Claude Code (não vai para o front-end)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
